{
    "name": "jonklein/mcp-wp-helper",
    "description": "Server-side companion for mcp-wp.",
    "license": "MIT",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "McpWpHelper\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "McpWpHelper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
